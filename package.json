  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "prepare": "lefthook install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm exec moon run ...:lint",
    "check-packages": "node scripts/check-packages.mjs",
    "check-docs-links": "node scripts/check-docs-links.mjs",
    "readiness": "node scripts/check-readiness.mjs",
    "test": "pnpm exec moon run gate-scripts:test",
    "typecheck": "pnpm exec moon run gate-scripts:typecheck",
    "e2e": "vitest run --config packages/archkeep/e2e/vitest.config.mjs"
  },
  "dependencies": {
    "smol-toml": "1.8.0",
    "typescript": "^6.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@fast-check/vitest": "^0.4.1",
    "@moonrepo/cli": "^2.4.6",
    "@nx/eslint-plugin": "23.1.3",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-xml-parser": "5.11.1",
    "globals": "^17.11.0",
    "lefthook": "^2.1.10",
    "nx": "^23.1.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.41",
    "vue-eslint-parser": "^10.4.1"
