{
  "name": "@ecoma-io/lattice",
  "version": "0.0.0",
  "private": true,
  "description": "Nx tooling that makes a polyglot workspace's dependency graph and module boundaries real.",
  "keywords": [
    "nx",
    "nx-plugin",
    "monorepo",
    "module-boundaries",
    "dependency-graph",
    "polyglot",
    "golang",
    "rust",
    "python",
    "typescript",
    "language-server",
    "static-analysis",
    "ecoma"
  ],
  "homepage": "https://github.com/ecoma-io/lattice#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecoma-io/lattice.git"
  },
  "bugs": {
    "url": "https://github.com/ecoma-io/lattice/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Mai Ngọc Hóa (John Martin)",
    "email": "john.itvn@gmail.com"
  },
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "prepare": "lefthook install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "check-packages": "node scripts/check-packages.mjs",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "tsc -p scripts/tsconfig.json"
  },
  "dependencies": {
    "smol-toml": "1.7.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@fast-check/vitest": "^0.4.1",
    "@nx/eslint-plugin": "23.1.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "lefthook": "^2.1.10",
    "nx": "^23.1.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-eslint-parser": "^10.4.1"
  }
}
