{
  "name": "@ecoma-io/archkeep",
  "version": "0.14.0",
  "private": true,
  "description": "Architecture enforcement for polyglot repositories — dependency graphs and module boundaries for the languages ESLint cannot read.",
  "keywords": [
    "architecture",
    "enforcement",
    "dependency-graph",
    "monorepo",
    "module-boundaries",
    "polyglot",
    "golang",
    "rust",
    "python",
    "typescript",
    "language-server",
    "static-analysis",
    "nx",
    "nx-plugin",
    "ecoma"
  ],
  "homepage": "https://github.com/ecoma-io/archkeep#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecoma-io/archkeep.git"
  },
  "bugs": {
    "url": "https://github.com/ecoma-io/archkeep/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Mai Ngọc Hóa (John Martin)",
    "email": "john.itvn@gmail.com"
  },
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "prepare": "lefthook install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "check-packages": "node scripts/check-packages.mjs",
    "check-docs-links": "node scripts/check-docs-links.mjs",
    "readiness": "node scripts/check-readiness.mjs",
    "test": "export ARCHKEEP_TEST_GLOB='scripts/**/*.test.mjs' && node -e \"if (require('node:fs').globSync(process.env.ARCHKEEP_TEST_GLOB).length === 0) { console.error('pnpm test: ' + process.env.ARCHKEEP_TEST_GLOB + ' matched no test file. node --test prints tests 0 and exits 0 on that, so a green run here would mean nothing ran.'); process.exit(1); }\" && node --test \"$ARCHKEEP_TEST_GLOB\"",
    "typecheck": "tsc -p scripts/tsconfig.json",
    "e2e": "vitest run --config packages/archkeep/e2e/vitest.config.mjs"
  },
  "dependencies": {
    "smol-toml": "1.8.0",
    "typescript": "^7.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@fast-check/vitest": "^0.4.1",
    "@moonrepo/cli": "^2.4.6",
    "@nx/eslint-plugin": "23.1.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "lefthook": "^2.1.10",
    "nx": "^23.1.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.41",
    "vue-eslint-parser": "^10.4.1"
  }
}
