{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [],
    "lintTooling": ["{workspaceRoot}/eslint.config.mjs"]
  },
  "plugins": [
    {
      "plugin": "./packages/lattice/nx.mjs",
      "options": {
        "boundaryConfig": "module-boundaries.config.mjs"
      }
    }
  ],
  "targetDefaults": {
    "lint": {
      "cache": true,
      "inputs": ["default", "lintTooling"]
    },
    "test": {
      "cache": true,
      "inputs": ["default"]
    },
    "build": {
      "cache": true,
      "inputs": ["default"],
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"]
    }
  }
}
