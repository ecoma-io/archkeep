$ export ARCHKEEP_TEST_GLOB='scripts/**/*.test.mjs' && node -e "if (require('node:fs').globSync(process.env.ARCHKEEP_TEST_GLOB).length === 0) { console.error('pnpm test: ' + process.env.ARCHKEEP_TEST_GLOB + ' matched no test file. node --test prints tests 0 and exits 0 on that, so a green run here would mean nothing ran.'); process.exit(1); }" && node --test "$ARCHKEEP_TEST_GLOB"
