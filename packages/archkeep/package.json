{
  "name": "@ecoma-io/archkeep",
  "version": "1.0.1-rc.1",
  "description": "Architecture enforcement for polyglot repositories — dependency graphs and module boundaries for Go, Rust, Python, TypeScript, JavaScript, Vue, Java and Kotlin",
  "keywords": [
    "architecture",
    "enforcement",
    "dependency-graph",
    "monorepo",
    "module-boundaries",
    "polyglot",
    "static-analysis",
    "language-server",
    "nx",
    "nx-plugin",
    "golang",
    "rust",
    "python",
    "typescript"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "archkeep": "cli.mjs",
    "archkeep-lsp": "lsp.mjs"
  },
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./nx": "./nx.mjs",
    "./commands": "./commands.mjs",
    "./presets/*.json": "./presets/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "nx.mjs",
    "commands.mjs",
    "cli.mjs",
    "lsp.mjs",
    "src/",
    "!src/**/*.test.mjs",
    "!src/conformance/",
    "!src/custom-rules/wasm-fixture.mjs",
    "!src/report/envelope-shape.json",
    "!src/custom-rules/evidence-golden.json",
    "presets/",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "smol-toml": "1.8.0"
  },
  "peerDependencies": {
    "@nx/eslint-plugin": ">=21",
    "fast-xml-parser": "5.11.0",
    "nx": ">=21",
    "typescript": ">=5 <7",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "@nx/eslint-plugin": {
      "optional": true
    },
    "fast-xml-parser": {
      "optional": true
    },
    "nx": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/ecoma-io/archkeep/tree/main/packages/archkeep#readme",
  "bugs": {
    "url": "https://github.com/ecoma-io/archkeep/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecoma-io/archkeep.git",
    "directory": "packages/archkeep"
  }
}
