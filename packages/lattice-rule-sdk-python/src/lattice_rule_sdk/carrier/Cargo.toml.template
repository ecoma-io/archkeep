# GENERATED by `python -m lattice_rule_sdk.build` — do not edit.
#
# The carrier crate for one Python rule. It is not published and not depended
# on: it exists for the length of one `cargo build`, and its output is the
# `.wasm` a workspace pins by digest.
#
# Three dependencies, and each is load-bearing:
#
#   lattice-rule-sdk  the contract binding — the typed evidence model, the four
#                     verdict constructors, and the `lattice_rule!` macro that
#                     writes the ABI exports. The Python carrier is a client of
#                     the Rust one rather than a second implementation of it,
#                     so the two SDKs cannot disagree about the wire.
#   rustpython-vm     the interpreter, with `default-features = false`. The
#                     default set includes `wasmbind`, which pulls
#                     `wasm-bindgen` and would put JavaScript imports in the
#                     module's import section — the one thing the host refuses
#                     outright. `compiler` is kept because the carrier compiles
#                     the author's source at startup; it is what makes the
#                     artifact reproducible from the `.py` in the tree rather
#                     than from bytecode nobody can read.
#   getrandom         named explicitly so the custom backend in `src/lib.rs`
#                     resolves. The build passes
#                     `--cfg getrandom_backend="custom"`; without it the crate
#                     has no backend on `wasm32-unknown-unknown` and fails to
#                     compile with a message about enabling one.
#
# `serde_json` is here because the carrier converts between JSON values and
# Python objects in both directions. It is the same version the SDK crate
# resolves, so the `Value` in one is the `Value` in the other.
[package]
name = "{{CRATE_NAME}}"
version = "0.0.0"
edition = "2024"
# The floor the SDK crate sets, restated because a carrier is compiled by the
# author's own toolchain and the failure is clearer here than inside a
# dependency.
rust-version = "1.85"
publish = false

[dependencies]
lattice-rule-sdk = {{SDK_DEPENDENCY}}
rustpython-vm = { version = "0.5.0", default-features = false, features = ["compiler"] }
getrandom = "0.3"
serde_json = "1"

[lib]
# A cdylib, which is what makes rustc's `wasm32-unknown-unknown` linkage export
# the module's linear memory under the name `memory` — the fourth ABI export,
# the one no macro writes.
crate-type = ["cdylib"]

# The profile the artifact is built with, stated here rather than in the build
# command so that a rebuild by hand produces what the build tool produces.
#
# `panic = "abort"` is a contract requirement rather than a size tweak:
# unwinding across the ABI's `extern "C"` boundary is undefined behaviour, so a
# panic must trap instead — and a trap is a failure the host NAMES rather than a
# verdict it invents.
#
# The size options matter more here than they do for a Rust rule, and for the
# same reason: the artifact is committed to the workspace that declares it and
# pinned by a sha256 in the policy row. An interpreter is large no matter what
# is done to it; these options are what keep "large" at single-digit megabytes.
[profile.release]
panic = "abort"
opt-level = "z"
lto = true
codegen-units = 1
strip = true
