/// What the conversion has left to spend.
///
/// Every Python object the conversion creates is counted, including the ones a
/// reader forgets to count: a dict's KEYS are strings, and there are more of
/// them than there are values.
struct Budget {
    remaining: Cell<usize>,
    spent: Cell<usize>,
}

impl Budget {
    fn new(limit: usize) -> Self {
        Self { remaining: Cell::new(limit), spent: Cell::new(0) }
    }

    /// Records `count` objects, or refuses because the next one would be past
    /// what this interpreter can hold.
    fn spend(&self, count: usize) -> Result<(), String> {
        let remaining = self.remaining.get();
        if count > remaining {
            return Err(format!(
                "this workspace is larger than a Python rule's embedded interpreter can hold: \
                 converting its evidence needs more than {} Python objects, and RustPython \
                 stores a strong reference count in 15 bits on wasm32, so the {}th live object \
                 of a kind aborts the module. The rule judged nothing — a partial verdict over \
                 the records that fit would be a clean workspace nobody earned. A rule that has \
                 to judge a workspace this size belongs in the Rust SDK, whose artifact holds \
                 no interpreter and has no such ceiling.",
                CONVERSION_BUDGET, 32_767
            ));
        }
        self.remaining.set(remaining - count);
        self.spent.set(self.spent.get() + count);
        Ok(())
    }
}

/// One `set_item` on a dict being built, with its KEY counted.
fn set(
    vm: &VirtualMachine,
    dict: &PyRef<PyDict>,
    key: &str,
    value: PyObjectRef,
    budget: &Budget,
) -> Result<(), String> {
    budget.spend(1)?;
    dict.set_item(key, value, vm)
        .map_err(|error| format!("the evidence could not be built: {}", exception_text(vm, error)))
}

fn new_dict(vm: &VirtualMachine, budget: &Budget) -> Result<PyRef<PyDict>, String> {
    budget.spend(1)?;
    Ok(vm.ctx.new_dict())
}

fn new_str(vm: &VirtualMachine, text: &str, budget: &Budget) -> Result<PyObjectRef, String> {
    budget.spend(1)?;
    Ok(vm.ctx.new_str(text).into())
}

fn new_list(
    vm: &VirtualMachine,
    items: Vec<PyObjectRef>,
    budget: &Budget,
) -> Result<PyObjectRef, String> {
    budget.spend(1)?;
    Ok(vm.ctx.new_list(items).into())
}

/// Any JSON value as the Python value a rule reads.
///
/// Used for the two places contract 1 deliberately carries un-modelled JSON —
/// a policy row and a rule's own `params` — so that what an author sees is what
/// the workspace wrote rather than what this file understood of it.
fn value_to_py(vm: &VirtualMachine, value: &Value, budget: &Budget) -> Result<PyObjectRef, String> {
    budget.spend(1)?;
    Ok(match value {
        Value::Null => vm.ctx.none(),
        Value::Bool(flag) => vm.ctx.new_bool(*flag).into(),
        Value::Number(number) => match number.as_i64() {
            Some(integer) => vm.ctx.new_int(integer).into(),
            // A JSON number past i64 is a float here rather than a refusal: it
            // cannot appear in evidence this engine builds, and a rule reading
            // a workspace's own `params` should not fail on a number it was
            // never going to compare.
            None => vm.ctx.new_float(number.as_f64().unwrap_or(f64::NAN)).into(),
        },
        Value::String(text) => vm.ctx.new_str(text.as_str()).into(),
        Value::Array(items) => {
            let mut converted = Vec::with_capacity(items.len());
            for item in items {
                converted.push(value_to_py(vm, item, budget)?);
            }
            vm.ctx.new_list(converted).into()
        }
        Value::Object(entries) => {
            let dict = vm.ctx.new_dict();
            for (key, item) in entries {
                let item = value_to_py(vm, item, budget)?;
                set(vm, &dict, key.as_str(), item, budget)?;
            }
            dict.into()
        }
    })
}

fn strings_to_py(
    vm: &VirtualMachine,
    items: &[String],
    budget: &Budget,
) -> Result<PyObjectRef, String> {
    let mut converted = Vec::with_capacity(items.len());
    for item in items {
        converted.push(new_str(vm, item.as_str(), budget)?);
    }
    new_list(vm, converted, budget)
}

fn optional_str_to_py(
    vm: &VirtualMachine,
    value: Option<&String>,
    budget: &Budget,
) -> Result<PyObjectRef, String> {
    match value {
        Some(text) => new_str(vm, text.as_str(), budget),
        // A shared singleton, but still one strong reference on it per use, so
        // it is counted like everything else.
        None => {
            budget.spend(1)?;
            Ok(vm.ctx.none())
        }
    }
}

fn new_bool(vm: &VirtualMachine, flag: bool, budget: &Budget) -> Result<PyObjectRef, String> {
    budget.spend(1)?;
    Ok(vm.ctx.new_bool(flag).into())
}

fn new_int(vm: &VirtualMachine, value: u32, budget: &Budget) -> Result<PyObjectRef, String> {
    budget.spend(1)?;
    Ok(vm.ctx.new_int(value).into())
}

fn needed(kind: &str) -> bool {
    NEEDS.contains(&kind)
}

/// The evidence bundle as the mapping `lattice_rule_sdk.Evidence` wraps.
///
/// Written out field by field rather than derived from a serializer, and the
/// reason is the wire contract: the keys below are the bundle's own spelling
/// (`../../../../../docs/reference/custom-rules.md`), so a field the SDK crate's
/// model does not carry cannot appear here by accident, and a rename on either
/// side is a compile error rather than a key that quietly stops arriving.
///
/// A kind the rule did not declare is converted as an empty collection and
/// never read: the runtime refuses the read first, naming the kind and the
/// `needs` that omitted it.
fn evidence_to_py(
    vm: &VirtualMachine,
    evidence: &Evidence,
    budget: &Budget,
) -> Result<PyObjectRef, String> {
    let root = new_dict(vm, budget)?;
    let contract = new_int(vm, evidence.contract, budget)?;
    set(vm, &root, "contract", contract, budget)?;

    // `rule` is not an evidence KIND — the bundle carries it beside them — so a
    // rule always reads its own name and parameters, whatever it declared.
    let rule = new_dict(vm, budget)?;
    let name = new_str(vm, evidence.rule.name.as_str(), budget)?;
    set(vm, &rule, "name", name, budget)?;
    let params = value_to_py(vm, &evidence.rule.params, budget)?;
    set(vm, &rule, "params", params, budget)?;
    set(vm, &root, "rule", rule.into(), budget)?;

    let mut projects = Vec::new();
    if needed("model") {
        projects.reserve(evidence.model.projects.len());
        for project in &evidence.model.projects {
            let entry = new_dict(vm, budget)?;
            let value = new_str(vm, project.name.as_str(), budget)?;
            set(vm, &entry, "name", value, budget)?;
            let value = new_str(vm, project.root.as_str(), budget)?;
            set(vm, &entry, "root", value, budget)?;
            let value = strings_to_py(vm, &project.tags, budget)?;
            set(vm, &entry, "tags", value, budget)?;
            projects.push(entry.into());
        }
    }
    let model = new_dict(vm, budget)?;
    let value = new_list(vm, projects, budget)?;
    set(vm, &model, "projects", value, budget)?;
    set(vm, &root, "model", model.into(), budget)?;

    let mut edges = Vec::new();
    if needed("graph") {
        edges.reserve(evidence.graph.edges.len());
        for edge in &evidence.graph.edges {
            let entry = new_dict(vm, budget)?;
            let value = new_str(vm, edge.source.as_str(), budget)?;
            set(vm, &entry, "source", value, budget)?;
            let value = new_str(vm, edge.target.as_str(), budget)?;
            set(vm, &entry, "target", value, budget)?;
            let value = new_str(vm, edge.edge_type.as_str(), budget)?;
            set(vm, &entry, "type", value, budget)?;
            let value = optional_str_to_py(vm, edge.source_file.as_ref(), budget)?;
            set(vm, &entry, "sourceFile", value, budget)?;
            edges.push(entry.into());
        }
    }
    let graph = new_dict(vm, budget)?;
    let value = new_list(vm, edges, budget)?;
    set(vm, &graph, "edges", value, budget)?;
    set(vm, &root, "graph", graph.into(), budget)?;

    let mut imports = Vec::new();
    if needed("imports") {
        imports.reserve(evidence.imports.len());
        for record in &evidence.imports {
            let entry = new_dict(vm, budget)?;
            let value = new_str(vm, record.source_project.as_str(), budget)?;
            set(vm, &entry, "sourceProject", value, budget)?;
            let value = new_str(vm, record.source_file.as_str(), budget)?;
            set(vm, &entry, "sourceFile", value, budget)?;
            let value = new_int(vm, record.line, budget)?;
            set(vm, &entry, "line", value, budget)?;
            let value = new_int(vm, record.column, budget)?;
            set(vm, &entry, "column", value, budget)?;
            let value = new_str(vm, record.specifier.as_str(), budget)?;
            set(vm, &entry, "specifier", value, budget)?;
            let value = new_str(vm, import_kind(record.kind), budget)?;
            set(vm, &entry, "kind", value, budget)?;

            let spelling = new_dict(vm, budget)?;
            let value = new_bool(vm, record.spelling.path, budget)?;
            set(vm, &spelling, "path", value, budget)?;
            let value = new_bool(vm, record.spelling.relative, budget)?;
            set(vm, &spelling, "relative", value, budget)?;
            set(vm, &entry, "spelling", spelling.into(), budget)?;

            let resolved: PyObjectRef = match &record.resolved {
                // `None` is a recorded blind spot rather than a missing key: the
                // analyzer looked and could not say, and a rule has to be able
                // to tell that apart from "resolves to nothing".
                None => {
                    budget.spend(1)?;
                    vm.ctx.none()
                }
                Some(resolved) => {
                    let target = new_dict(vm, budget)?;
                    let value = optional_str_to_py(vm, resolved.target.as_ref(), budget)?;
                    set(vm, &target, "target", value, budget)?;
                    let value = optional_str_to_py(vm, resolved.file.as_ref(), budget)?;
                    set(vm, &target, "file", value, budget)?;
                    let value = new_bool(vm, resolved.external, budget)?;
                    set(vm, &target, "external", value, budget)?;
                    let value = optional_str_to_py(vm, resolved.package_name.as_ref(), budget)?;
                    set(vm, &target, "packageName", value, budget)?;
                    target.into()
                }
            };
            set(vm, &entry, "resolved", resolved, budget)?;
            imports.push(entry.into());
        }
    }
    let value = new_list(vm, imports, budget)?;
    set(vm, &root, "imports", value, budget)?;

    let policy = new_dict(vm, budget)?;
    let mut rows = Vec::new();
    let options: PyObjectRef = if needed("policy") {
        rows.reserve(evidence.policy.dep_constraints.len());
        for row in &evidence.policy.dep_constraints {
            rows.push(value_to_py(vm, row, budget)?);
        }
        value_to_py(vm, &evidence.policy.module_boundary_options, budget)?
    } else {
        new_dict(vm, budget)?.into()
    };
    let value = new_list(vm, rows, budget)?;
    set(vm, &policy, "depConstraints", value, budget)?;
    set(vm, &policy, "moduleBoundaryOptions", options, budget)?;
    set(vm, &root, "policy", policy.into(), budget)?;

    Ok(root.into())
}

/// The wire spelling of an import's form.
///
/// A `match` rather than a `Display` impl on the SDK's enum: the four strings
/// are the analysis contract's (`../../../../lattice/src/analysis/contract.md`), and
/// the compiler is what makes a fifth variant a build failure here instead of a
/// kind that silently reaches Python as something else.
fn import_kind(kind: lattice_rule_sdk::ImportKind) -> &'static str {
    match kind {
        lattice_rule_sdk::ImportKind::Static => "static",
        lattice_rule_sdk::ImportKind::Dynamic => "dynamic",
        lattice_rule_sdk::ImportKind::TypeOnly => "type-only",
        lattice_rule_sdk::ImportKind::ReExport => "re-export",
    }
}

