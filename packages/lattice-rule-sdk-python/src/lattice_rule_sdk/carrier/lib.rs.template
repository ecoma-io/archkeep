/// One Python value as JSON, or the reason it has no JSON spelling.
///
/// Only the verdict mapping crosses in this direction, so the accepted set is
/// deliberately small: a rule that answered with a set, a generator or an object
/// of its own gets a named `unknown` rather than a stringified guess.
fn py_to_value(vm: &VirtualMachine, object: &PyObjectRef) -> Result<Value, String> {
    if vm.is_none(object) {
        return Ok(Value::Null);
    }
    // Checked before the integer arm: a Python bool IS an int, and reading
    // `True` back as `1` would turn a flag into a number.
    if object.class().is(vm.ctx.types.bool_type) {
        return Ok(Value::Bool(object.clone().try_to_bool(vm).unwrap_or(false)));
    }
    if let Some(text) = object.downcast_ref::<PyStr>() {
        let text = text
            .to_str()
            .ok_or_else(|| "the rule answered text that is not valid UTF-8".to_owned())?;
        return Ok(Value::String(text.to_owned()));
    }
    if let Some(integer) = object.downcast_ref::<PyInt>() {
        let narrowed: i64 = integer.as_bigint().try_into().map_err(|_| {
            "the rule answered an integer past i64, which is not a position or a count".to_owned()
        })?;
        return Ok(Value::Number(narrowed.into()));
    }
    if let Some(float) = object.downcast_ref::<PyFloat>() {
        let number = serde_json::Number::from_f64(float.to_f64()).ok_or_else(|| {
            "the rule answered a non-finite float, which JSON cannot carry".to_owned()
        })?;
        return Ok(Value::Number(number));
    }
    if let Some(list) = object.downcast_ref::<PyList>() {
        let mut items = Vec::new();
        for item in list.borrow_vec().iter() {
            items.push(py_to_value(vm, item)?);
        }
        return Ok(Value::Array(items));
    }
    if let Some(tuple) = object.downcast_ref::<PyTuple>() {
        let mut items = Vec::new();
        for item in tuple.iter() {
            items.push(py_to_value(vm, item)?);
        }
        return Ok(Value::Array(items));
    }
    if let Some(dict) = object.downcast_ref::<PyDict>() {
        let mut entries = serde_json::Map::new();
        for (key, item) in dict {
            let key: &str = key
                .downcast_ref::<PyStr>()
                .and_then(|text| text.to_str())
                .ok_or_else(|| "the rule answered a mapping whose keys are not text".to_owned())?;
            entries.insert(key.to_owned(), py_to_value(vm, &item)?);
        }
        return Ok(Value::Object(entries));
    }
    Err(format!(
        "the rule answered a {}, which has no JSON spelling",
        object.class().name()
    ))
}

