/// A Python exception as the sentence a reader sees.
///
/// The interpreter's own rendering, because it names the exception type, its
/// message and the source line — everything an author needs, and nothing this
/// file could reconstruct as well.
fn exception_text(vm: &VirtualMachine, exception: PyRef<PyBaseException>) -> String {
    let mut rendered = String::new();
    match vm.write_exception_inner(&mut rendered, &exception) {
        Ok(()) => rendered.trim().to_owned(),
        // A formatter that cannot format is still an answer, and an empty
        // reason would be indistinguishable from no failure at all.
        Err(_) => "an exception this interpreter could not render".to_owned(),
    }
}

fn compile_and_run(
    vm: &VirtualMachine,
    source: &str,
    name: &str,
    scope: &Scope,
) -> Result<(), String> {
    let code = vm
        .compile(source, Mode::Exec, name.to_owned())
        .map_err(|error| format!("{name} does not compile: {error}"))?;
    vm.run_code_obj(code, scope.clone())
        .map(|_| ())
        .map_err(|error| format!("{name} raised while loading: {}", exception_text(vm, error)))
}

/// Everything between an evidence bundle and a verdict mapping.
fn run(evidence: &Evidence) -> Result<Value, String> {
    let mut settings = Settings::default();
    // The interpreter's hash seed, pinned. Left unset it is drawn from the
    // fixed generator above, which would already be deterministic — stating it
    // makes the determinism a property of this file rather than a consequence
    // of a backend someone could change.
    settings.hash_seed = Some(0);

    // No standard library, and none is registered afterwards: this interpreter
    // holds the modules the VM itself implements and nothing else. What that
    // costs an author is listed in `../../../README.md`, measured rather than
    // guessed, and it is the price of an artifact a reviewer can hash.
    let interpreter = Interpreter::without_stdlib(settings);

    interpreter.enter(|vm| -> Result<Value, String> {
        let runtime_scope = vm.new_scope_with_builtins();
        compile_and_run(vm, RUNTIME_SOURCE, RUNTIME_MODULE, &runtime_scope)?;
        let runtime_module = vm.new_module(RUNTIME_MODULE, runtime_scope.globals.clone(), None);
        vm.sys_module
            .get_attr("modules", vm)
            .and_then(|modules| modules.set_item(RUNTIME_MODULE, runtime_module.into(), vm))
            .map_err(|error| {
                format!(
                    "the runtime module could not be registered: {}",
                    exception_text(vm, error)
                )
            })?;

        let rule_scope = vm.new_scope_with_builtins();
        compile_and_run(vm, RULE_SOURCE, "rule.py", &rule_scope)?;

        let evaluate = rule_scope.globals.get_item("evaluate", vm).map_err(|_| {
            "rule.py defines no evaluate(evidence) function — the build tool reads it by name"
                .to_owned()
        })?;
        let drive = runtime_scope.globals.get_item("drive", vm).map_err(|_| {
            "the embedded lattice_rule_sdk runtime defines no drive(evaluate, bundle, needs)"
                .to_owned()
        })?;

        let budget = Budget::new(CONVERSION_BUDGET);
        let bundle = evidence_to_py(vm, evidence, &budget)?;
        let mut declared = Vec::with_capacity(NEEDS.len());
        for kind in NEEDS {
            declared.push(vm.ctx.new_str(*kind).into());
        }
        let needs = vm.ctx.new_list(declared);

        // `drive` catches the rule's own exceptions and turns them into an
        // `unknown` mapping, so a failure here is a failure of the runtime
        // itself rather than of the rule — reported as such, never as a pass.
        let answered = drive
            .call((evaluate, bundle, needs), vm)
            .map_err(|error| format!("the runtime's drive() raised: {}", exception_text(vm, error)))?;
        py_to_value(vm, &answered)
    })
}

/// One verdict mapping as the SDK's `Verdict`.
///
/// The four states are rebuilt through the SDK's own constructors rather than
/// serialized straight through, so the obligations they enforce — a `fail`
/// names a finding, `unknown` and `not_applicable` name a reason — hold for a
/// Python rule exactly as they hold for a Rust one. A mapping that does not
/// answer one of the four is `unknown` naming what arrived instead.
fn verdict_from(document: Value) -> Verdict {
    let Value::Object(mapping) = document else {
        return Verdict::unknown(
            "the rule's evaluate answered something that is not a verdict mapping",
        );
    };

    let Some(kind) = mapping.get("verdict").and_then(Value::as_str) else {
        return Verdict::unknown("the rule's verdict names no kind");
    };

    let mut findings = Vec::new();
    if let Some(entries) = mapping.get("findings").and_then(Value::as_array) {
        for entry in entries {
            match finding_from(entry) {
                Ok(finding) => findings.push(finding),
                Err(reason) => return Verdict::unknown(reason),
            }
        }
    }

    match kind {
        // `Verdict::pass()` rather than `from_findings`: a mapping that says
        // "pass" and carries findings is a rule contradicting itself, and the
        // host names that as a hollow verdict. Silently dropping the findings
        // here would hide the contradiction instead.
        "pass" => match findings.is_empty() {
            true => Verdict::pass(),
            false => Verdict::unknown(format!(
                "the rule answered \"pass\" and carried {} finding(s) — \"pass\" and \"fail\" \
                 cannot both be true of the same rule",
                findings.len()
            )),
        },
        "fail" => match findings.is_empty() {
            false => Verdict::from_findings(findings),
            true => Verdict::unknown(
                "the rule answered \"fail\" and named no finding, so nothing says what failed",
            ),
        },
        "unknown" => match mapping.get("reason").and_then(Value::as_str) {
            Some(reason) if !reason.is_empty() => Verdict::unknown(reason),
            _ => Verdict::unknown("the rule answered \"unknown\" and named no reason"),
        },
        "not_applicable" => match mapping.get("notApplicableReason").and_then(Value::as_str) {
            Some(reason) if !reason.is_empty() => Verdict::not_applicable(reason),
            _ => Verdict::unknown("the rule answered \"not_applicable\" and named no reason"),
        },
        other => Verdict::unknown(format!(
            "the rule answered the verdict \"{other}\", and the vocabulary is pass, fail, \
             unknown, not_applicable"
        )),
    }
}

fn finding_from(value: &Value) -> Result<Finding, String> {
    let Value::Object(mapping) = value else {
        return Err(format!("the rule answered a finding that is not a mapping: {value}"));
    };
    let id = mapping
        .get("id")
        .and_then(Value::as_str)
        .ok_or_else(|| "the rule answered a finding that names no id".to_owned())?;
    let message = mapping
        .get("message")
        .and_then(Value::as_str)
        .ok_or_else(|| "the rule answered a finding that carries no message".to_owned())?;

    let mut finding = Finding::new(id, message);
    if let Some(project) = mapping.get("project").and_then(Value::as_str) {
        finding = finding.in_project(project);
    }
    if let Some(source_file) = mapping.get("sourceFile").and_then(Value::as_str) {
        finding = match (mapping.get("line"), mapping.get("column")) {
            (Some(line), Some(column)) => {
                let position = line
                    .as_u64()
                    .and_then(|line| u32::try_from(line).ok())
                    .and_then(NonZeroU32::new)
                    .zip(
                        column
                            .as_u64()
                            .and_then(|column| u32::try_from(column).ok())
                            .and_then(NonZeroU32::new),
                    );
                match position {
                    Some((line, column)) => finding.at(source_file, line, column),
                    None => {
                        return Err(
                            "the rule answered a finding whose position is not a pair of 1-based \
                             integers"
                                .to_owned(),
                        );
                    }
                }
            }
            _ => finding.in_file(source_file),
        };
    }
    Ok(finding)
}

fn evaluate(evidence: &Evidence) -> Verdict {
    match run(evidence) {
        Ok(document) => verdict_from(document),
        // Every path into here is a rule that could not be run: source that
        // does not compile, an import the interpreter has no module for, a
        // workspace past the object ceiling. None of them is a clean workspace,
        // and none of them answers `pass`.
        Err(reason) => Verdict::unknown(reason),
    }
}

