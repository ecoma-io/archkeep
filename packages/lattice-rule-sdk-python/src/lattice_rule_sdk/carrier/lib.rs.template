/// The SDK's authoring runtime, embedded. Byte-identical to the `runtime.py`
/// the author's own CPython imports, which is what makes the golden suite's
/// verdicts and this artifact's verdicts the same claim.
const RUNTIME_SOURCE: &str = include_str!("lattice_rule_sdk.py");

/// The author's rule, embedded verbatim.
const RULE_SOURCE: &str = include_str!("rule.py");

/// The module name `rule.py` imports the runtime under.
const RUNTIME_MODULE: &str = "lattice_rule_sdk";

/// The evidence kinds this rule declared, in the wire's spelling. The runtime
/// refuses a read of any kind not listed here, so the collections below are
/// built only for the ones that are.
const NEEDS: &[&str] = &[{{NEEDS_WIRE}}];

/// How many Python objects the evidence conversion may create.
///
/// The header argues the number. It is a total rather than a per-type cap
/// because a total of N guarantees no single type reached N, which is the
/// property the refcount ceiling actually needs — and because a per-type model
/// would be a second copy of what the conversion does, drifting the first time
/// a field was added.
const CONVERSION_BUDGET: usize = 30_000;

/// The randomness a rule gets: a fixed sequence, and the same one every run.
///
/// `getrandom` is a non-optional dependency of the interpreter, and on
/// `wasm32-unknown-unknown` it has no backend unless one is named — the build
/// passes `--cfg getrandom_backend="custom"` and this is what that names. A
/// backend that reached a real entropy source would need an import, and the
/// host refuses a module that declares one, so the only question was WHICH
/// fixed sequence rather than whether to fix it.
///
/// Determinism here is a feature and not a compromise. A rule is a pure
/// function from evidence to verdict; two runs over an unchanged tree that
/// disagreed would be a rule nobody could review. The interpreter's hash seed
/// is pinned separately, in `run` below, because hash randomization would
/// otherwise reorder set iteration between runs.
#[unsafe(no_mangle)]
unsafe extern "Rust" fn __getrandom_v03_custom(
    dest: *mut u8,
    len: usize,
) -> Result<(), GetrandomError> {
    let mut state: u64 = 0x9E37_79B9_7F4A_7C15;
    for offset in 0..len {
        state = state
            .wrapping_mul(6_364_136_223_846_793_005)
            .wrapping_add(1_442_695_040_888_963_407);
        // SAFETY: the caller owns `len` writable bytes at `dest`; getrandom's
        // custom-backend contract requires every one of them to be written,
        // and this loop writes exactly that range.
        unsafe { core::ptr::write(dest.add(offset), (state >> 33) as u8) };
    }
    Ok(())
}

