{
  "name": "@ecoma-io/lattice",
  "version": "0.8.0",
  "description": "Architecture enforcement for polyglot repositories — dependency graphs and module boundaries for Go, Rust, Python, TypeScript, JavaScript and Vue",
  "keywords": [
    "architecture",
    "enforcement",
    "dependency-graph",
    "monorepo",
    "module-boundaries",
    "polyglot",
    "static-analysis",
    "language-server",
    "nx",
    "nx-plugin",
    "golang",
    "rust",
    "python",
    "typescript"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "lattice": "cli.mjs",
    "lattice-lsp": "lsp.mjs"
  },
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./nx": "./nx.mjs",
    "./presets/*.json": "./presets/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "nx.mjs",
    "cli.mjs",
    "lsp.mjs",
    "src/",
    "!src/**/*.test.mjs",
    "!src/conformance/",
    "presets/",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "smol-toml": "1.7.1"
  },
  "peerDependencies": {
    "@nx/eslint-plugin": ">=21",
    "nx": ">=21",
    "typescript": ">=5 <7",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "@nx/eslint-plugin": {
      "optional": true
    },
    "nx": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/ecoma-io/lattice/tree/main/packages/lattice#readme",
  "bugs": {
    "url": "https://github.com/ecoma-io/lattice/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecoma-io/lattice.git",
    "directory": "packages/lattice"
  }
}
