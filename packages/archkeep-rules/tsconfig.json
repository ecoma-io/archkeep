// The `typecheck` target's program, and only its program: `tsc` here judges the
// validator under `src/` and the test harness under `test/`, and nothing else.
//
// It extends the root `tsconfig.base.json` for `module: nodenext`, which is
// what lets the validator import from node:crypto. The options on top are the
// ones `../archkeep/tsconfig.json` argues in its own header, for the same
// reasons: nothing is emitted, the JSDoc is the program, and dependency `.d.ts`
// files are not this target's to fix.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "target": "es2022",
    "skipLibCheck": true
  },
  "include": ["src/**/*.mjs", "test/**/*.mjs"]
}
