// Dependency updates run through Renovate, covering the two ecosystems that live
// here: npm/pnpm (the root package.json + pnpm-lock.yaml, and every future
// packages/* manifest, which Renovate's pnpm-workspace support finds on its own)
// and github-actions (.github/workflows/*.yml) — both auto-detected by
// Renovate's default managers.
//
// Activation: this file alone does nothing. Renovate only runs once the official
// Renovate GitHub App (Mend) is installed on the repository by someone with
// organisation admin rights — https://github.com/apps/renovate. Chosen over
// self-hosting Renovate as a scheduled workflow because a self-hosted run needs
// its own PAT or App token to let its pull requests trigger the required checks
// (the default GITHUB_TOKEN cannot trigger other workflows, so every single
// Renovate PR would need a manual "Approve workflows to run"). The App has no
// such gap, and it avoids introducing a long-lived credential this repository
// does not otherwise hold.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // Pins every `uses:` to a full commit SHA and keeps the `# vX.Y.Z` comment
    // beside it in step. This is also what .github/semgrep/workflows.yaml
    // enforces from the other side: the preset does the work, the rule fails
    // loud if a workflow is hand-edited past it.
    "helpers:pinGitHubActionDigests",
    ":enableVulnerabilityAlertsWithLabel(security)",
  ],
  timezone: "Asia/Ho_Chi_Minh",
  // Weekly, not continuous. This is a small, single-maintainer repository; a
  // drip of pull requests through the day would be noise rather than signal.
  schedule: ["before 6am on monday"],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on monday"],
  },
  // Must satisfy the commitlint gate (CONTRIBUTING.md): Conventional Commits,
  // with a scope drawn from commitlint.config.mjs's enum. Renovate's default
  // templates render the rest as "update dependency <name> to <version>", so a
  // full message reads "chore(deps): update dependency nx to v23.1.2".
  semanticCommits: "enabled",
  semanticCommitType: "chore",
  semanticCommitScope: "deps",
  packageRules: [
    {
      matchManagers: ["github-actions"],
      semanticCommitScope: "ci",
      pinDigests: true,
    },
    {
      // The Semgrep analyser runs as a job container, written as
      // `tag@sha256:...` so the tag stays readable while the digest is what
      // actually resolves. Same reasoning as actions: a tag is not a fixed
      // reference, and an analyser that changes silently makes a rerun mean
      // something different from the run it repeats.
      matchDatasources: ["docker"],
      semanticCommitScope: "ci",
      pinDigests: true,
    },
    {
      // Nx's CLI and every `@nx/*` package share one release train and are
      // version-locked against each other. Splitting them across pull requests
      // produces a window where the plugin API a package compiles against is
      // not the one the CLI loading it ships.
      matchPackageNames: ["nx", "@nx/**"],
      groupName: "nx",
      semanticCommitScope: "deps",
    },
    {
      // Formatter and linter bumps arrive together, because a Prettier release
      // that reflows files and an ESLint release that re-reports them are one
      // review, not two.
      matchPackageNames: ["prettier", "eslint", "eslint-config-prettier", "@eslint/js"],
      groupName: "lint and format toolchain",
    },
  ],
  customManagers: [
    {
      // The Semgrep image is pinned inside a job's `container.image`, which
      // Renovate's github-actions manager does not read — it looks at `uses:`.
      // Without this manager the analyser would stay on 1.172.0 forever while
      // every other dependency moved, and nothing would say so.
      customType: "regex",
      description: "The Semgrep analyser image in the Analysis workflow",
      managerFilePatterns: ["/^\\.github/workflows/analysis\\.yml$/"],
      matchStrings: [
        "image:\\s+(?<depName>semgrep/semgrep):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)",
      ],
      datasourceTemplate: "docker",
    },
  ],
}
