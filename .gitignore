node_modules/
dist/
coverage/

# Nx's local cache and daemon state. Never committed: the cache is keyed on a
# machine's own inputs, and a stale entry replaying as green is the one failure
# mode a cache must not have.
.nx/

# Moon's local cache — same reasoning as `.nx/` above.
.moon/cache/

# Cargo's build directory, for the Rust packages under `packages/`.
#
# Stated here rather than in a `.gitignore` beside the crate, and the reason is
# measured: Prettier reads the ROOT ignore files only, so a crate-local entry
# leaves `packages/lattice-rule-sdk-rust/target/` visible to `prettier --check .`
# — which then reports style violations inside cargo's build cache on any
# machine that has run `cargo test`, while CI (where nothing has built yet)
# stays green. One entry that both git and Prettier read is the only spelling
# that makes those two agree.
packages/*/target/

# Editors / OS
.DS_Store
*.local
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Claude Code local overrides — the shared settings.json IS tracked.
.claude/settings.local.json
# Claude Code plan files
.claude/plans/
# Claude Code worktrees — full clones of this repository, one per worktree.
# Prettier and the boundary checker would otherwise scan every clone.
.claude/worktrees/

# Test fixtures created inside the package root by `mkdtempSync(join(packageRoot,
# ".cli-eslint-config-fixture-"))` in cli.integration.test.mjs and
# eslint-config.integration.test.mjs. The tests clean them up in `afterAll`, but
# an interrupted run leaves them behind, and an untracked fixture dir is exactly
# the shape of accidental `git add -A`. Kept out of git rather than moved to
# tmpdir(): the fixtures must sit inside the package to be resolvable by the
# resolver under test.
packages/lattice/.cli-eslint-config-fixture-*/
__pycache__/
