{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format-edited-file.mjs",
            "statusMessage": "Formatting edited file"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/lint-edited-file.mjs",
            "statusMessage": "Linting edited file"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "lattice@lattice": true
  }
}
